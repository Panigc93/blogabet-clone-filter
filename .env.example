# Copy to .env.local and fill in real values. Never commit .env.local or real values.
# Pooled/HTTP Neon URL for the Next.js app (db/index.ts) and _query.mts
DATABASE_URL=
# Direct Neon URL for crawler/* scripts and drizzle.config.ts
DATABASE_URL_DIRECT=
# Shared site password for /login and middleware
SITE_PASSWORD=
# HMAC key used to sign the auth cookie
AUTH_SECRET=
# Blogabet session cookie, used by the crawlers only
BLOGABET_COOKIE=
